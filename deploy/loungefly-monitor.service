[Unit]
Description=Loungefly product availability monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=loungefly
Group=loungefly
WorkingDirectory=/opt/loungefly-monitor
EnvironmentFile=/opt/loungefly-monitor/.env
ExecStart=/opt/loungefly-monitor/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/loungefly-monitor/data /opt/loungefly-monitor/logs
UMask=0077

[Install]
WantedBy=multi-user.target
