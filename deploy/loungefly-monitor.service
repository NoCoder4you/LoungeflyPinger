[Unit]
Description=Loungefly product availability monitor
Wants=network-online.target
Wants=loungefly-update.service
After=network-online.target loungefly-update.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/LoungeflyPinger
EnvironmentFile=/home/pi/LoungeflyPinger/.env
ExecStart=/home/pi/LoungeflyPinger/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/LoungeflyPinger/data /home/pi/LoungeflyPinger/logs
UMask=0077

[Install]
WantedBy=multi-user.target
