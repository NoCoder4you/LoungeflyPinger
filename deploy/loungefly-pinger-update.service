[Unit]
Description=Update LoungeflyPinger before startup
Wants=network-online.target
After=network-online.target
Before=loungefly-pinger.service

[Service]
Type=oneshot
User=loungefly
Group=loungefly
WorkingDirectory=/opt/LoungeflyPinger
ExecStart=/opt/LoungeflyPinger/deploy/update.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/LoungeflyPinger
UMask=0077

[Install]
WantedBy=multi-user.target
