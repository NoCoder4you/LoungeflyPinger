[Unit]
Description=Update Loungefly monitor before startup
Wants=network-online.target
After=network-online.target
Before=loungefly-monitor.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/LoungeflyPinger
ExecStart=/home/pi/LoungeflyPinger/update.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/LoungeflyPinger
UMask=0077

[Install]
WantedBy=multi-user.target
