[Unit]
Description=Update Loungefly monitor before startup
Wants=network-online.target
After=network-online.target
Before=loungefly-monitor.service
# Avoid the normal boot updater running again when the external supervisor
# starts the candidate while holding the production update lock.
ConditionPathExists=!/home/pi/LoungeflyPinger/data/.discord-update-in-progress

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/LoungeflyPinger
ExecStart=/home/pi/LoungeflyPinger/update.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/LoungeflyPinger
UMask=0077

[Install]
WantedBy=multi-user.target
