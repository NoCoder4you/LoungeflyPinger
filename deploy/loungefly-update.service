[Unit]
Description=Update Loungefly monitor before startup
Wants=network-online.target
After=network-online.target
Before=loungefly-monitor.service

[Service]
Type=oneshot
User=loungefly
Group=loungefly
WorkingDirectory=/opt/loungefly-monitor
ExecStart=/opt/loungefly-monitor/deploy/update.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/loungefly-monitor
UMask=0077

[Install]
WantedBy=multi-user.target
