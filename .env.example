# Copy this file to .env, restrict it with `chmod 600 .env`, and set real values.
# Never commit .env. Blank webhook values disable the corresponding destination.
DISCORD_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_PRODUCT_REMOVED_ENABLED=true
DISCORD_SOLD_OUT_ENABLED=true

# Optional runtime overrides (defaults shown).
LOUNGEFLY_DATABASE_PATH=data/loungefly.db
LOUNGEFLY_BACKUP_DIRECTORY=data/backups
LOUNGEFLY_BACKUP_INTERVAL_HOURS=24
LOUNGEFLY_BACKUP_COUNT=7
LOUNGEFLY_LOG_PATH=logs/loungefly-monitor.log
LOUNGEFLY_LOG_LEVEL=INFO

# Optional Discord slash-command control plane (disabled by default).
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_BOT_GUILD_ID=
DISCORD_BOT_ALLOWED_USER_IDS=
DISCORD_BOT_ALLOWED_ROLE_IDS=

# Product-alert mentions. Existing installations default to everyone.
# Modes: none, role, everyone. Role mode also requires DISCORD_ALERT_ROLE_ID.
DISCORD_ALERT_MENTION_MODE=everyone
DISCORD_ALERT_ROLE_ID=
